{
  "info": {
    "_postman_id": "893df49c-f2a3-481b-871d-a0e4c6a99281",
    "name": "PulseFlow Project Management API",
    "description": "Comprehensive Postman collection for PulseFlow Full-Stack Project Management & Collaboration Tool REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "boardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.tokens.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token Rotation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Projects",
      "item": [
        {
          "name": "Get All Projects (with Search & Pagination)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/projects?search=&status=active&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["projects"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "status", "value": "active" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.project) {",
                  "    pm.collectionVariables.set('projectId', jsonData.data.project._id);",
                  "    pm.collectionVariables.set('boardId', jsonData.data.defaultBoardId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile Banking App V2\",\n  \"key\": \"BANK\",\n  \"description\": \"Next-generation mobile banking experience with biometrics\",\n  \"color\": \"#0ea5e9\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        },
        {
          "name": "Get Project by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}"] }
          }
        },
        {
          "name": "Invite Member to Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"role\": \"member\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/members", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "members"] }
          }
        },
        {
          "name": "Get Project Activity Log",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/activity?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "activity"] }
          }
        }
      ]
    },
    {
      "name": "3. Boards",
      "item": [
        {
          "name": "Get Boards by Project",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/boards/project/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["boards", "project", "{{projectId}}"] }
          }
        },
        {
          "name": "Create Board",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sprint 43 (Upcoming)\",\n  \"description\": \"Sprint planning and backlog grooming\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/boards/project/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["boards", "project", "{{projectId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Tasks & Kanban",
      "item": [
        {
          "name": "Get Tasks by Board (with Multi-Filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks/board/{{boardId}}?search=&priority=&status=&dueDateFilter=&sortBy=order",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "board", "{{boardId}}"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "priority", "value": "" },
                { "key": "status", "value": "" },
                { "key": "dueDateFilter", "value": "" },
                { "key": "sortBy", "value": "order" }
              ]
            }
          }
        },
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.task) {",
                  "    pm.collectionVariables.set('taskId', jsonData.data.task._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement Stripe 3D Secure Webhook handler\",\n  \"description\": \"Ensure webhook signature verification and store payment intent states in MongoDB\",\n  \"status\": \"in-progress\",\n  \"priority\": \"urgent\",\n  \"dueDate\": \"2026-08-25T18:00:00.000Z\",\n  \"tags\": [\"backend\", \"payments\", \"stripe\"],\n  \"subtasks\": [\n    { \"title\": \"Verify webhook signature\", \"completed\": true },\n    { \"title\": \"Update order collection on success\", \"completed\": false }\n  ],\n  \"estimatedHours\": 8\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/board/{{boardId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "board", "{{boardId}}"] }
          }
        },
        {
          "name": "Update Task Status (Todo -> In Progress -> Done)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\",\n  \"columnId\": \"col-done\",\n  \"order\": 1000\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}/status", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}", "status"] }
          }
        },
        {
          "name": "Reorder Tasks (Drag & Drop Sync)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskId\": \"{{taskId}}\",\n  \"sourceStatus\": \"in-progress\",\n  \"destinationStatus\": \"done\",\n  \"newOrder\": 2000,\n  \"columnId\": \"col-done\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/reorder", "host": ["{{baseUrl}}"], "path": ["tasks", "reorder"] }
          }
        }
      ]
    },
    {
      "name": "5. Comments & Discussion",
      "item": [
        {
          "name": "Get Comments by Task",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/comments/task/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["comments", "task", "{{taskId}}"] }
          }
        },
        {
          "name": "Post Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"I updated the webhook handler with exponential retry logic. Ready for code review!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/comments/task/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["comments", "task", "{{taskId}}"] }
          }
        }
      ]
    }
  ]
}
